{
  "name": "openorganizer",
  "private": false,
  "version": "1.0.0",
  "description": "Powerful desktop application for automated file organization with smart presets.",
  "author": "Ishan Rai",
  "license": "MIT",
  "keywords": [
    "electron",
    "react",
    "vite",
    "file-manager",
    "automation",
    "productivity"
  ],
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite --force\" \"cross-env NODE_ENV=development wait-on tcp:5173 && electron .\"",
    "build": "vite build && electron-builder",
    "vercel-build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.openorganizer.app",
    "productName": "OpenOrganizer",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "lucide-react": "^1.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.1.1",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "vite": "^8.0.1",
    "wait-on": "^9.0.4"
  }
}
